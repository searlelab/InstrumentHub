scheduler.lab.internal {
    tls "__DATA_DIRECTORY__/certs/scheduler.crt" "__DATA_DIRECTORY__/certs/scheduler.key"
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
        -Server
    }
    reverse_proxy 127.0.0.1:8000
}
